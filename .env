IMG_Y2=img/y2.webp

# --- Album: Khoảnh khắc (4 ảnh) ---
IMG_K1=img/k1.webp
IMG_K2=img/k2.webp
IMG_K3=img/k3.webp
IMG_K4=img/k4.webp

# --- Ảnh cưới: mục "Chung đôi" (tối đa 10 ảnh, hiện theo thứ tự W1 -> W10) ---
# Bỏ trống ô nào thì ảnh đó không hiện. Để trống hết = hiện dòng "Ảnh cưới cập nhật sau".
# Ví dụ: IMG_W1=img/cuoi1.jpg   (nhớ bỏ file ảnh vào thư mục img/)
IMG_W1=img/album-web/VOU07478_60x90.webp
IMG_W2=img/album-web/VOU07514_60x90.webp
IMG_W3=img/album-web/VOU07552.webp
