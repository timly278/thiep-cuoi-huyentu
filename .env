# ============================================================
#  CẤU HÌNH THIỆP CƯỚI
#  Sửa file này xong chạy:   node build.js
#  (lệnh trên tạo ra config.js - file mà index.html đọc)
#  Nhớ commit/upload cả config.js lên GitHub.
#  Để trống 1 dòng = dùng ảnh/giá trị mặc định.
# ============================================================

# --- Google Sheet đã "Xuất bản lên web" dạng CSV (hiện tường lời chúc) ---
# Để trống = không hiện tường lời chúc.
# Lưu ý: link đúng thường có dạng  https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
SHEET_CSV=https://docs.google.com/spreadsheets/d/1dMAgFrzLVqMdlZC68uhBUO2occzn9YSQOr-3R4ZiNp8/edit?usp=sharing

# --- Ảnh cô dâu / chú rể (ảnh tròn ở mục "Cô dâu & Chú rể") ---
IMG_BRIDE=img/bride.webp
IMG_GROOM=img/groom.webp

# --- Câu chuyện: Quen biết (2 ảnh) ---
IMG_Q1=img/q1.webp
IMG_Q2=img/q2.webp

# --- Câu chuyện: Yêu thương (2 ảnh) ---
